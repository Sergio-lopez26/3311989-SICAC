<?xml version="1.0" encoding="utf-8"?>
<!-- drawerlayout es como un menú lateral
    /res-auto -> es para componentes más avanzados y android para lo normal -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayoutMedico"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Barra superior azul para el Médico -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarMedico"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#005EE6"
                app:titleTextColor="#FFFFFF">

            <TextView
                    android:id="@+id/btnCerrarSesionM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/borde_boton_blanco"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Cerrar Sesión"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Marco dinámico donde se cargarán las paginas -->
        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_medico_pag"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_medico" />
    </LinearLayout>

    <!-- Menú lateral con la lista de opciones -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationViewMedico"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Inicio -->
            <TextView
                    android:id="@+id/btnMenuInicioMedico"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@drawable/ic_home"
                    android:drawablePadding="8dp"
                    android:text="Inicio"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Perfil -->
            <TextView
                    android:id="@+id/btnTogglePerfilM"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="8dp"
                    android:text="Perfil"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Perfil -->
            <LinearLayout
                    android:id="@+id/subMenuPerfilM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarPerfilMedico"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Mi Perfil"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Toggle Mapa Dental -->
            <TextView
                    android:id="@+id/btnToggleMapaDental"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_view"
                    android:drawablePadding="8dp"
                    android:text="Mapa Dental ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Mapa Dental -->
            <LinearLayout
                    android:id="@+id/subMenuMapaDental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarMapaDental"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="Gestionar Mapa Dental"
                        android:textSize="15sp" />
            </LinearLayout>

            <!-- Toggle Servicios -->
            <TextView
                    android:id="@+id/btnToggleServicios"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_manage"
                    android:drawablePadding="8dp"
                    android:text="Servicios ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Servicios -->
            <LinearLayout
                    android:id="@+id/subMenuServicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarServicios"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="Gestionar Servicios"
                        android:textSize="15sp" />
            </LinearLayout>

            <!-- Toggle Pacientes -->
            <TextView
                    android:id="@+id/btnTogglePacientes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_agenda"
                    android:drawablePadding="8dp"
                    android:text="Pacientes ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Pacientes -->
            <LinearLayout
                    android:id="@+id/subMenuPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Historial"
                        android:textSize="15sp" />

                <TextView
                        android:id="@+id/btnGestionarAntecedentes"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Antecedentes"
                        android:textSize="15sp" />
            </LinearLayout>

            <!-- Toggle Agenda -->
            <TextView
                    android:id="@+id/btnToggleAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="8dp"
                    android:text="Agenda ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Agenda -->
            <LinearLayout
                    android:id="@+id/subMenuAgenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnConsultarAgenda"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Consultar Agenda"
                        android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>