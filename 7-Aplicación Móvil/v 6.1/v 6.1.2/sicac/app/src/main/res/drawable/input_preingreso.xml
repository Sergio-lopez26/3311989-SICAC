<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Es como el input:focus (Cuando el usuario hace clic para escribir) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <!-- Borde y color equivalente a (#color.rango de opacidad) -> con opacidad como en el css -->
            <stroke android:width="5dp" android:color="#E53F8CFB" />
            <!-- Para el radius -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Es como el input a secas sin interacción-->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="3dp" android:color="#B2CBFB" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
