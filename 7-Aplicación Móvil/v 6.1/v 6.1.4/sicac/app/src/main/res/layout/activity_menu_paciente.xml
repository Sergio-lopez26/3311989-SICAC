<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayoutPaciente"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Barra superior azul (como en nuestro frontend) para Admin -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarPaciente"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#005EE6"
                app:titleTextColor="#FFFFFF">

            <TextView
                    android:id="@+id/btnCerrarSesionP"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/borde_boton_blanco"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:text="Cerrar Sesión"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Marco dinámico donde se cargarán las paginas -->
        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_paciente_pag"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_paciente" />
    </LinearLayout>

    <!-- Menú lateral con la lista de opciones -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationViewPaciente"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Inicio -->
            <TextView
                    android:id="@+id/btnMenuInicioPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawablePadding="8dp"
                    android:text="Inicio"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Perfil -->
            <TextView
                    android:id="@+id/btnTogglePerfil"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="8dp"
                    android:text="Perfil ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Perfil -->
            <LinearLayout
                    android:id="@+id/subMenuPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarPerfilPaciente"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Mi Perfil"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Historial -->
            <TextView
                    android:id="@+id/btnToggleHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="8dp"
                    android:text="Historial ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Historial -->
            <LinearLayout
                    android:id="@+id/subMenuHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnVerHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Ver Historial"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Cita -->
            <TextView
                    android:id="@+id/btnToggleCita"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="8dp"
                    android:text="Cita ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Cita -->
            <LinearLayout
                    android:id="@+id/subMenuCita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnAgendarCita"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Agendar Cita"
                        android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>


</androidx.drawerlayout.widget.DrawerLayout>
