<?xml version="1.0" encoding="utf-8"?>
<!-- drawerlayout es como un menú lateral
    /res-auto -> es para componentes más avanzados y android para lo normal-->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayoutAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Barra superior azul (como en nuestro frontend) para Admin -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarAdmin"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#005EE6"
                app:titleTextColor="#FFFFFF">

        <TextView
                android:id="@+id/btnCerrarSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/borde_boton_blanco"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Cerrar Sesión"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Marco dinámico donde se cargarán las paginas -->
        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_admin_pag"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_admin" />
    </LinearLayout>

    <!-- Menú lateral con la lista de opciones -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationViewAdmin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Inicio -->
            <TextView
                    android:id="@+id/btnMenuInicio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_compass"
                    android:drawablePadding="8dp"
                    android:text="Inicio"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Pacientes -->
            <TextView
                    android:id="@+id/btnTogglePacientes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="8dp"
                    android:text="Pacientes ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Pacientes -->
            <LinearLayout
                    android:id="@+id/subMenuPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarPacientes"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Pacientes"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Médicos -->
            <TextView
                    android:id="@+id/btnToggleMedicos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_add"
                    android:drawablePadding="8dp"
                    android:text="Médicos ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Médicos -->
            <LinearLayout
                    android:id="@+id/subMenuMedicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnRegistrarMedico"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Registrar Médico"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarMedicos"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Médicos"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Usuarios -->
            <TextView
                    android:id="@+id/btnToggleUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_lock_idle_lock"
                    android:drawablePadding="8dp"
                    android:text="Usuarios ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Usuarios -->
            <LinearLayout
                    android:id="@+id/subMenuUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarTDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Tipos de Documento"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarRoles"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Roles"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarRolUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Rol de Usuario"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Odontología y Servicios -->
            <TextView
                    android:id="@+id/btnToggleOdontologia"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_agenda"
                    android:drawablePadding="8dp"
                    android:text="Odontologia y Servicios ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Odontología y Servicios -->
            <LinearLayout
                    android:id="@+id/subMenuOdontologia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarMDentales"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Mapas Dentales"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarServicios"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Servicios"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarTServicio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Tipos de Servicio"
                        android:textSize="15sp" />

            </LinearLayout>

            <!-- Citas y Pagos -->
            <TextView
                    android:id="@+id/btnToggleCitas"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:drawableStart="@android:drawable/ic_menu_today"
                    android:drawablePadding="8dp"
                    android:text="Citas y Pagos ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Citas y Pagos -->
            <LinearLayout
                    android:id="@+id/subMenuCitas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarCPagos"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Citas y Pagos"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarTCita"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Tipos de Cita"
                        android:textSize="15sp" />
                <TextView
                        android:id="@+id/btnGestionarMPago"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Métodos de Pago"
                        android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>


</androidx.drawerlayout.widget.DrawerLayout>
