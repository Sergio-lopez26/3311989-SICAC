<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F6F9"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Encabezado -->
        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Gestionar Antecedentes"
                android:textColor="#103E6E"
                android:textSize="24sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Selecciona un paciente para gestionar su historial"
                android:textColor="#6C757D"
                android:textSize="14sp" />

        <!-- Contenedor Buscador (Visible cuando NO hay paciente seleccionado) -->
        <LinearLayout
                android:id="@+id/contenedorBuscadorAntecedentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Buscar paciente por nombre o documento..."
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:endIconMode="clear_text">

                <AutoCompleteTextView
                        android:id="@+id/etBuscarPacienteAntecedentes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:inputType="text"
                        android:padding="14dp"
                        android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <ProgressBar
                android:id="@+id/progressAntecedentes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        <!-- Contenedor Detalle Paciente + Formulario + Diagnósticos Anteriores -->
        <LinearLayout
                android:id="@+id/contenedorDetalleAntecedentes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <!-- Tarjeta Paciente Seleccionado -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#103E6E"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/tvPacienteSeleccionadoAnt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Paciente seleccionado: Nombre"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/tvDocPacienteAnt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Documento: ---"
                                android:textColor="#E0E0E0"
                                android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                            android:id="@+id/btnCambiarPacienteAnt"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cambiar"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#FFFFFF" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjeta Formulario de Antecedentes Médicos -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="Antecedentes Médicos:"
                            android:textColor="#0D6EFD"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <EditText
                            android:id="@+id/etAntecedentesMedicos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:background="@android:drawable/edit_text"
                            android:gravity="top"
                            android:hint="Escribe los antecedentes médicos del paciente..."
                            android:inputType="textMultiLine|textCapSentences"
                            android:lines="5"
                            android:padding="12dp" />

                    <Button
                            android:id="@+id/btnGuardarAntecedentes"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:backgroundTint="#198754"
                            android:text="Guardar Antecedentes"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Sección Diagnósticos Anteriores -->
            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Diagnósticos anteriores"
                    android:textColor="#212529"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tvSinDiagnosticos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="No se encontraron diagnósticos."
                    android:textColor="#6C757D"
                    android:visibility="gone" />

            <!-- Contenedor dinámico donde se agregan las tarjetas de diagnósticos -->
            <LinearLayout
                    android:id="@+id/contenedorListaDiagnosticos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>