<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="32dp"
              android:background="#d9ecff">
              <!--android:gravity="center"-->


    <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="190dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/logo"
            android:contentDescription="Logo de Sicac"/>
    <TextView
            android:id="@+id/textView"
            android:layout_width="163dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center_horizontal"
            android:text="Iniciar Sesión"
            android:textSize="24dp"
            android:textStyle="bold"
            android:textColor="#103e6e"/>
    <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite el Email"
            android:paddingStart="16dp"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"
            android:textColor="#000000"
            android:background="@drawable/input_preingreso"
            android:textCursorDrawable="@null"
            android:minHeight="48dp"/> <!-- hint -> importante -->

    <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite la Contraseña"
            android:paddingStart="16dp"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:background="@drawable/input_preingreso"
            android:textCursorDrawable="@null"
            android:layout_marginBottom="16dp"
            android:minHeight="48dp"/>

    <!--Esto es para que android respete el diseño que creamos o diseñamos -no se como se diga mejor- -->
    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresar"
            android:textColor="#FFFFFF"
            android:background="@drawable/boton_azul"/> <!--Acá llamamos el diseño creado en drawable (toca ese nombre) -->

    <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/> <!-- Esto es para ocultarlo al inicio del login -->
</LinearLayout>