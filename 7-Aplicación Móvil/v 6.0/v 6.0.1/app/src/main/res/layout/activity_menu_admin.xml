<?xml version="1.0" encoding="utf-8"?>
<!-- drawerlayput es como el menu hamburguesa -->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://android.com"
        android:id="@+id/drawerLayoutAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Barra superior azul para Admin -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarAdmin"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#005EE6"
                app:titleTextColor="#FFFFFF"/>

        <!-- Marco dinámico donde se cargarán las paginas -->
        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_admin_pag"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_admin" />


    </LinearLayout>

    <!-- Menú lateral con la lista de opciones -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationViewAdmin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:menu="@menu/menu_admin" />

</androidx.drawerlayout.widget.DrawerLayout>
