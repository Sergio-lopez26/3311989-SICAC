<?xml version="1.0" encoding="utf-8"?>
<!-- drawerlayout es como un menú lateral
    /res-auto -> es para componentes más avanzados y android para lo normal-->
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/drawerLayoutAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <!-- Barra superior azul (como en nuestro frontend) para Admin -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarAdmin"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#005EE6"
                app:titleTextColor="#FFFFFF"/>

        <!-- Marco dinámico donde se cargarán las paginas -->
        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/nav_admin_pag"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_admin" />
    </LinearLayout>

    <!-- Menú lateral con la lista de opciones -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/navigationViewAdmin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:fitsSystemWindows="true">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Inicio -->
            <TextView
                    android:id="@+id/btnMenuInicio"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:icon="@drawable/ic_home"
                    android:text="Inicio"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Pacientes -->
            <TextView
                    android:id="@+id/btnTogglePacientes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:icon="@android:drawable/ic_menu_agenda"
                    android:text="Pacientes ▾"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <!-- Sub Menu Pacientes -->
            <LinearLayout
                    android:id="@+id/subMenuPacientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/btnGestionarPacientes"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:text="• Gestionar Pacientes"
                        android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>


</androidx.drawerlayout.widget.DrawerLayout>
