<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Es como el input:focus (Cuando el usuario hace clic para escribir) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <!-- Borde y color de focus -->
            <stroke android:width="3dp" android:color="#96BAF3" />
            <!-- Para el radius -->
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Es como el input a secas sin interacción-->
    <item>
        <shape android:shape="rectangle">
            <!-- Equivalente a (rgba 0,0,0,0.06) -> con opacidad como en el css -->
            <solid android:color="#0F000000" />
            <stroke android:width="3dp" android:color="#D0E2FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
