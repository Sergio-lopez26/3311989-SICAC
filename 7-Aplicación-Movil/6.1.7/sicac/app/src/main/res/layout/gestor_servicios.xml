<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de cada servicio en la lista (mismo estilo que gestor_pacientes) -->
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#B8DAFF">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                    android:id="@+id/tvNombreServicio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Servicio"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#103e6e" />

            <TextView
                    android:id="@+id/tvPrecioBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="$0"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#198754" />
        </LinearLayout>

        <TextView
                android:id="@+id/tvPaciente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Paciente: N/A"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#212529" />

        <TextView
                android:id="@+id/tvTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tipo: —"
                android:textSize="13sp"
                android:textColor="#495057" />

        <TextView
                android:id="@+id/tvDiagnostico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Diagnóstico: 1"
                android:textSize="13sp"
                android:textColor="#495057" />

        <TextView
                android:id="@+id/tvProcedimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Procedimiento:"
                android:textSize="13sp"
                android:textColor="#495057" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
