<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de cada mapa dental en la lista (mismo estilo que gestor_pacientes) -->
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="#B8DAFF">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                    android:id="@+id/tvNombreMapa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="serif"
                    android:text="Mapa inicial"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#103e6e" />

            <TextView
                    android:id="@+id/tvEstadoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Activo"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#198754" />
        </LinearLayout>

        <TextView
                android:id="@+id/tvHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ID: 1 | Historial médico: 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#212529" />

        <TextView
                android:id="@+id/tvObservacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Observación: Ninguna"
                android:textSize="13sp"
                android:textColor="#495057" />

        <Button
                android:id="@+id/btnVerOdontograma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ver Odontograma"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#0D6EFD" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
